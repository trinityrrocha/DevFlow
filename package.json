{
  "name": "devflow",
  "version": "0.4.7-alpha",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter ./backend --filter ./frontend dev",
    "build": "pnpm --filter ./frontend build",
    "test": "pnpm --filter ./backend test && pnpm --filter ./frontend test",
    "lint": "pnpm --filter ./backend lint && pnpm --filter ./frontend lint",
    "validate:compose": "node scripts/validate-compose.mjs",
    "validate:operations": "node scripts/validate-operations.mjs",
    "validate:shared-proxy": "node scripts/validate-shared-proxy.mjs",
    "validate:fullpassword-adapter": "node scripts/validate-fullpassword-adapter.mjs",
    "validate:privileged-compose": "node scripts/validate-privileged-compose.mjs",
    "validate:compose-discovery": "node scripts/validate-compose-discovery.mjs",
    "validate:providers": "node scripts/validate-providers.mjs",
    "validate:proxy-migration-evidence": "node scripts/validate-proxy-migration-evidence.mjs",
    "validate:version-policy": "node scripts/validate-version-policy.mjs",
    "validate:installation-scopes": "node scripts/validate-installation-scopes.mjs",
    "validate:compose-images-resume": "node scripts/validate-compose-images-resume.mjs",
    "validate:compose-env": "node scripts/validate-compose-env.mjs",
    "validate:install-startup": "node scripts/validate-install-startup.mjs",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "validate:interactive-menus": "node scripts/validate-interactive-menus.mjs",
    "audit:bash-initialization": "node scripts/audit-bash-initialization.mjs",
    "audit:fullpassword-readonly": "node scripts/audit-fullpassword-readonly.mjs",
    "audit:repository": "node scripts/repository-audit.mjs",
    "audit:history": "node scripts/history-audit.mjs",
    "audit:version-constants": "node scripts/audit-version-constants.mjs",
    "audit:compose-command": "node scripts/audit-compose-command.mjs",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm validate:compose && pnpm validate:operations && pnpm validate:shared-proxy && pnpm validate:fullpassword-adapter && pnpm validate:privileged-compose && pnpm validate:compose-discovery && pnpm validate:providers && pnpm validate:proxy-migration-evidence && pnpm validate:version-policy && pnpm validate:installation-scopes && pnpm validate:compose-images-resume && pnpm validate:compose-env && pnpm validate:install-startup && pnpm validate:migrations && pnpm validate:interactive-menus && pnpm audit:bash-initialization && pnpm audit:compose-command && pnpm audit:fullpassword-readonly && pnpm audit:repository && pnpm audit:version-constants && pnpm audit:history"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  }
}
