# Managed by DevFlow installer.
[Unit]
Description=Renovacao do certificado HTTPS do DevFlow
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/docker compose --env-file /opt/devflow/config/devflow.env -p devflow --project-directory /opt/devflow/app -f /opt/devflow/app/docker-compose.yml --profile operations run --rm certbot renew --webroot --webroot-path /var/www/certbot --quiet
ExecStartPost=/usr/bin/docker exec devflow-nginx nginx -s reload
