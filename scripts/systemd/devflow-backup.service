# Managed by DevFlow installer.
[Unit]
Description=Backup diário criptografado do DevFlow
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Environment=DEVFLOW_PROJECT_DIR=/opt/devflow/app
Environment=DEVFLOW_ENV_FILE=/opt/devflow/config/devflow.env
Environment=BACKUP_PASSPHRASE_FILE=/opt/devflow/config/backup.passphrase
ExecStart=/opt/devflow/app/scripts/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
