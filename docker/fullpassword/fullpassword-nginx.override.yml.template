# Managed by DevFlow Full Password proxy adapter. Stored exclusively under /opt/devflow.
services:
  nginx:
    volumes:
      - type: bind
        source: /opt/devflow/config/nginx/devflow.conf
        target: /etc/nginx/conf.d/devflow.conf
        read_only: true
      - type: bind
        source: /opt/devflow/storage/acme
        target: /var/www/certbot
        read_only: true
    networks:
      - fullpassword_network
      - devflow_edge

networks:
  devflow_edge:
    external: true
    name: devflow_edge
