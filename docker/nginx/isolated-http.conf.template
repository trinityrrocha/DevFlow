server {
    listen 80;
    server_name ${DEVFLOW_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        return 200 "devflow-acme-ready\n";
    }

    location / {
        add_header Retry-After "120" always;
        return 503;
    }
}
