# Managed by DevFlow installer. Do not merge with another application.
# Temporary HTTP configuration for certificate issuance.
server {
    listen 80;
    server_name __DEVFLOW_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /opt/devflow/storage/acme;
    }

    location / {
        add_header Retry-After 60 always;
        return 503;
    }
}
