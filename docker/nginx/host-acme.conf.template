# Managed by DevFlow installer. Do not merge with another application.
# Temporary HTTP configuration for certificate issuance.
server {
    listen 80;
    server_name __DEVFLOW_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:__DEVFLOW_API_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:__DEVFLOW_HTTP_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
