# Managed by DevFlow Full Password proxy adapter. Independent virtual host.
server {
    listen 80;
    server_name __DEVFLOW_DOMAIN__;
    location / { return 503; }
}

server {
    listen 443 ssl;
    server_name __DEVFLOW_DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__DEVFLOW_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DEVFLOW_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Retry-After 60 always;
    location / { return 503; }
}
