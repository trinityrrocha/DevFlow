# DevFlow 0.4.8-alpha — contrato de ambiente sem credenciais reais

# Aplicação
DEVFLOW_VERSION=0.4.8-alpha
DEVFLOW_RELEASE_COMMIT=
DEVFLOW_IMAGE_TAG=latest
DEVFLOW_SOURCE_DIR=/opt/devflow/source
NODE_ENV=production
PORT=3000
TZ=America/Sao_Paulo
APP_ORIGIN=https://devflow.example.com
VITE_API_URL=/api

# Banco de dados
DB_HOST=db
DB_PORT=5432
DB_USER=devflow_user
DB_PASSWORD=
DB_NAME=devflow_db
DEVFLOW_DB_DATA_PATH=/opt/devflow/data/postgres

# Autenticação, sessão e bootstrap
JWT_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
SUPER_ADMIN_EMAIL=owner@example.com
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60

# MFA e criptografia
CONFIG_ENCRYPTION_KEY=

# SMTP opcional
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Storage
UPLOAD_DIR=/var/lib/devflow/uploads
DEVFLOW_UPLOADS_PATH=/opt/devflow/storage/uploads
MAX_UPLOAD_MB=25

# Backup
BACKUP_ARCHIVE_DIR=/opt/devflow/backups
BACKUP_PASSPHRASE_FILE=/opt/devflow/config/backup.passphrase
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_RESTORE_MB=4096

# Proxy, domínio e HTTPS
DEVFLOW_DOMAIN=devflow.example.com
DEVFLOW_INFRASTRUCTURE_PROVIDER=host-nginx
# Campos de compatibilidade; o provider e a fonte de verdade.
DEVFLOW_PROXY_MODE=shared
DEVFLOW_SHARED_PROXY_ADAPTER=host-nginx
DEVFLOW_ENV_FILE=/opt/devflow/config/devflow.env
DEVFLOW_BIND_ADDRESS=127.0.0.1
DEVFLOW_HTTP_PORT=18080
DEVFLOW_API_PORT=13000
LETSENCRYPT_EMAIL=owner@example.com

# Logs
LOG_LEVEL=info
DEVFLOW_LOG_ROOT=/opt/devflow/logs

# Métricas
METRICS_REFRESH_SECONDS=60

# Atualização transacional de homologação
UPDATE_CHANNEL=main
