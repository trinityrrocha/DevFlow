# DevFlow 0.6.18-alpha - contrato de ambiente sem credenciais reais

# Aplicacao
DEVFLOW_VERSION=0.6.18-alpha
DEVFLOW_RELEASE_COMMIT=
DEVFLOW_IMAGE_TAG=latest
DEVFLOW_SOURCE_DIR=/opt/devflow/source
DEVFLOW_ENV_FILE=/opt/devflow/config/devflow.env
NODE_ENV=production
PORT=3000
TZ=America/Sao_Paulo
APP_ORIGIN=https://devflow.example.com
VITE_API_URL=/api
DEVFLOW_DOMAIN=devflow.example.com

# Identidade administrativa (uma unica autoridade)
ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_EMAIL=owner@example.com
LETSENCRYPT_EMAIL=owner@example.com

# Banco de dados
DB_HOST=db
DB_PORT=5432
DB_USER=devflow_user
DB_PASSWORD=
DB_NAME=devflow_db
DEVFLOW_DB_DATA_PATH=/opt/devflow/storage/postgres

# Autenticacao, sessao e bootstrap
JWT_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60

# MFA e criptografia
# A autoridade de obrigatoriedade e persistida no banco (optional/admins/all); o padrao e optional.
CONFIG_ENCRYPTION_KEY=

# SMTP opcional e worker de outbox
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_MAX_ATTEMPTS=5
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30

# Storage, certificado do host e Nginx runtime
UPLOAD_DIR=/var/lib/devflow/uploads
DEVFLOW_UPLOADS_PATH=/opt/devflow/storage/uploads
DEVFLOW_CERTIFICATE_PATH=/etc/letsencrypt
DEVFLOW_NGINX_CONFIG_PATH=/opt/devflow/config/nginx/nginx.runtime.conf
DEVFLOW_UPDATER_ROOT=/opt/devflow/updater
MAX_UPLOAD_MB=25

# Backup
BACKUP_ARCHIVE_DIR=/opt/devflow/backups
BACKUP_PASSPHRASE_FILE=/opt/devflow/config/backup.passphrase
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_RESTORE_MB=4096

# Logs e metricas
LOG_LEVEL=info
DEVFLOW_LOG_ROOT=/opt/devflow/logs
METRICS_REFRESH_SECONDS=60

# Atualizacao transacional
UPDATE_CHANNEL=main
UPDATE_API_ENABLED=true
UPDATE_REQUEST_SECRET=
