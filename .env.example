# DevFlow 0.5.0-alpha - contrato de ambiente sem credenciais reais

# Aplicacao
DEVFLOW_VERSION=0.5.0-alpha
DEVFLOW_RELEASE_COMMIT=
DEVFLOW_IMAGE_TAG=latest
DEVFLOW_SOURCE_DIR=/opt/devflow/source
DEVFLOW_ENV_FILE=/opt/devflow/config/devflow.env
NODE_ENV=production
PORT=3000
TZ=America/Sao_Paulo
APP_ORIGIN=https://devflow.example.com
VITE_API_URL=/api
DEVFLOW_DOMAIN=devflow.example.com

# Identidade administrativa (uma unica autoridade)
ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_EMAIL=owner@example.com
LETSENCRYPT_EMAIL=owner@example.com

# Banco de dados
DB_HOST=db
DB_PORT=5432
DB_USER=devflow_user
DB_PASSWORD=
DB_NAME=devflow_db
DEVFLOW_DB_DATA_PATH=/opt/devflow/storage/postgres

# Autenticacao, sessao e bootstrap
JWT_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60

# MFA e criptografia
CONFIG_ENCRYPTION_KEY=

# SMTP opcional
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Storage e ACME
UPLOAD_DIR=/var/lib/devflow/uploads
DEVFLOW_UPLOADS_PATH=/opt/devflow/storage/uploads
DEVFLOW_ACME_PATH=/opt/devflow/storage/acme
DEVFLOW_CERTIFICATE_PATH=/opt/devflow/certificates
DEVFLOW_NGINX_CONFIG_PATH=/opt/devflow/config/nginx/active.conf.template
MAX_UPLOAD_MB=25

# Backup
BACKUP_ARCHIVE_DIR=/opt/devflow/backups
BACKUP_PASSPHRASE_FILE=/opt/devflow/config/backup.passphrase
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_RESTORE_MB=4096

# Logs e metricas
LOG_LEVEL=info
DEVFLOW_LOG_ROOT=/opt/devflow/logs
METRICS_REFRESH_SECONDS=60

# Atualizacao transacional
UPDATE_CHANNEL=main
UPDATE_API_ENABLED=false
